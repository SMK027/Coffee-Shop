{
  "expo": {
    "name": "Coffee Shop",
    "slug": "coffee-shop-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.leofranz.coffeeshop",
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra est utilisée pour scanner les QR codes et codes-barres des cartes de fidélité.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.leofranz.coffeeshop",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#EFE4D2"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6add9558-b931-40c3-97ca-5a8227385f2a"
      }
    },
    "owner": "smk_9119",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
